WHATSAPP_BRIDGE_URL=http://localhost:3000
KALI_GATEWAY_PORT=8001

# Phase B: Telegram (uncomment when ready)
# TELEGRAM_BOT_TOKEN=

# Phase B: Discord (uncomment when ready)
# DISCORD_BOT_TOKEN=

# Phase B: Slack (uncomment when ready)
# SLACK_BOT_TOKEN=your_groq_api_key_here

# Optional: NVIDIA API Keys
NV_GEMMA_KEY=your_nvidia_gemma_key_here
NV_USDCODE_KEY=your_nvidia_usdcode_key_here
NV_PHI3_KEY=your_nvidia_phi3_key_here

# Security
SECRET_KEY=your_sturdy_32_char_hex_secret_here

# Local AI
USE_LOCAL_AI=false
